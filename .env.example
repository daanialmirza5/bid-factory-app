# ==============================================================================
# BidFactory environment template - copy to .env and fill in. NEVER commit .env.
# [REQUIRED] needed for staging   [OPTIONAL] has a working default
# [SECRET] never log/commit       [DEV] local development only
# ==============================================================================

# --- RocketRide connections (managed by the IDE extension / `rocketride login`) ---
# Development pair: run/validate/iterate pipelines.            [REQUIRED][SECRET key]
ROCKETRIDE_URI=https://staging.rocketride.ai:443
ROCKETRIDE_APIKEY=
# Deployment target pair: `rocketride deploy ...`.             [REQUIRED for deploy][SECRET key]
ROCKETRIDE_DEPLOY_URI=https://staging.rocketride.ai:443
ROCKETRIDE_DEPLOY_APIKEY=

# --- LLM provider keys ---
# Groq key. Used by bid_factory.pipe (${ROCKETRIDE_GROQ_KEY}) and by the backend's
# direct-Groq paths (chat, response generation, pipeline fallback).
# For pipeline runs it may instead be set as a RocketRide server-side secret.  [REQUIRED][SECRET]
ROCKETRIDE_GROQ_KEY=
# Alternative name read by response generation only.                           [OPTIONAL][SECRET]
GROQ_API_KEY=
ROCKETRIDE_GEMINI_KEY=

# --- Backend (server-only) ---
# CORS allowlist, JSON list (pydantic-settings parses list fields as JSON).
# Staging: include the origin the UI is served from, e.g. the RocketRide app
# origin https://staging.rocketride.ai.                                        [REQUIRED for cross-origin UI]
FRONTEND_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Set true to extract requirements by calling Groq directly when the RocketRide
# pipeline fails. Off: pipeline failures return HTTP 503.                      [OPTIONAL]
AI_FALLBACK_DIRECT_GROQ=false
ROCKETRIDE_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO

# --- Frontend (PUBLIC: baked into the JS bundle; never put secrets here) ---
# Base URL of the FastAPI backend when the UI is not served by FastAPI itself.
# Vite build reads VITE_API_BASE_URL; the RocketRide (Rsbuild) app build reads
# PUBLIC_API_BASE_URL. Empty = same origin.                                    [PUBLIC]
VITE_API_BASE_URL=
PUBLIC_API_BASE_URL=

# --- Neo4j graph (optional; the app bypasses GraphRAG when unreachable) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Required by docker-compose.yml.                                              [SECRET]
NEO4J_PASSWORD=

# --- Knowledge base / vector store (local filesystem) ---               [OPTIONAL]
KNOWLEDGE_BASE_DIR=data/knowledge_base
VECTOR_STORE_DIR=data/vector_store
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.25
