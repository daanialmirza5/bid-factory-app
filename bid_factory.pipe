      ]
    },
    {
      "id": "prompt_1",
      "provider": "prompt",
      "name": "Requirement Extraction Instructions",
      "config": {
        "instructions": [
          "Extract only requirements explicitly present in the supplied RFP text.",
          "Split compound requirements into separate atomic requirements.",
          "Preserve the original requirement wording as much as possible.",
          "Preserve source page and section information when available.",
          "Return only a JSON array of requirement objects with fields requirement_id, requirement_text, category, priority, deadline, compliance_type, source_section, and source_page.",
          "Use null for unavailable optional fields.",
          "Never invent requirements, deadlines, priorities, certifications, capabilities, or compliance claims.",
          "Do not generate company answers or claim that the company satisfies anything."
        ]
      },
      "ui": {
        "position": {
          "x": 700,
          "y": 80
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "questions",
          "from": "question_1"
        }
      ]
    },
    {
      "id": "llm_gemini_1",
      "provider": "llm_openai_api",
      "name": "AI Requirement Extraction",
      "config": {
        "profile": "custom",
        "custom": {
          "model": "openai/gpt-oss-120b",
          "base_url": "https://api.groq.com/openai/v1",
          "modelTotalTokens": 131072,
          "apikey": "${ROCKETRIDE_GROQ_KEY}"
        },
        "parameters": {}
      },
